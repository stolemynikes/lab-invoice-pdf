# Copy this file to .env and fill in your own details.
# Never share your .env file or commit it to GitHub.

# ---------- Your company (printed on every invoice) ----------
# Exact name as registered at the KvK, including "B.V."
SELLER_LEGAL_NAME=Your Company B.V.
# Shop name, if it differs from the legal name (printed as "... is a trade name of ...")
SELLER_TRADE_NAME=
# Statutaire zetel (city in your articles of association)
SELLER_REGISTERED_SEAT=Amsterdam
SELLER_ADDRESS_LINE1=Street 1
SELLER_ADDRESS_LINE2=1234 AB Amsterdam
SELLER_COUNTRY=NL
SELLER_KVK=12345678
SELLER_VAT_ID=NL000000000B01
SELLER_IBAN=NL00BANK0000000000
SELLER_BIC=BANKNL2A
SELLER_EMAIL=info@example.nl
SELLER_PHONE=+31 00 000 0000
SELLER_WEBSITE=www.example.nl

# ---------- Shopify ----------
# Your store address, e.g. my-store.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Client ID of your app (Dev Dashboard -> your app -> Settings)
SHOPIFY_CLIENT_ID=
# Client secret of your app (starts with shpss_). Also used to check that webhooks really come from Shopify
SHOPIFY_CLIENT_SECRET=

# ---------- Invoice app ----------
PORT=8080
# Public address of this app, used in the download links
PUBLIC_URL=http://localhost:8080
# Long random text used to sign download links (make one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))")
INVOICE_LINK_SECRET=
# Where the PDF invoices are saved. Can be a NAS share, e.g. \\NAS\invoices or /mnt/nas/invoices
INVOICE_PDF_DIR=./data/invoices
# The invoice-number database. Keep this on a local disk (not the NAS) and back it up.
DATABASE_PATH=./data/invoices.db
# Invoice number prefix: INV-2026-00001
INVOICE_SERIES=INV
# Credit note number prefix: CN-2026-00001
CREDIT_NOTE_SERIES=CN
# How many digits after the year (8 gives INV-2026-00000001). Change this only before the first real invoice.
INVOICE_NUMBER_DIGITS=8
# Check customer VAT numbers with the EU VIES service (true/false)
VIES_ENABLED=true

# ---------- Look of the invoice ----------
# Logo: PNG (with transparent background), JPG or SVG. Use a large version (at least 1000 pixels wide) for sharp printing.
BRAND_LOGO=./assets/logo.png
# Shop name written next to the logo icon, in the website font (Open Sans). Leave empty if the logo file already has the name in it.
BRAND_LOGO_TEXT=
# Logo colour, used when DESIGN_ACCENT=navy. Keep the quotes: # starts a comment in .env
BRAND_COLOR="#1e4475"
# Design of the invoice. See all options with: npm run designs
# header: classic | centered | panel
# table:  lines | striped | boxed
# total:  line | box | bar
# accent: none | navy (uses BRAND_COLOR for the title and the total)
DESIGN_HEADER=classic
DESIGN_TABLE=lines
DESIGN_TOTAL=line
DESIGN_ACCENT=none

# ---------- Catch-up (after a power cut or internet problem) ----------
# Every this many minutes, the app asks Shopify for paid orders and refunds that still miss an invoice or credit note
CATCH_UP_MINUTES=60
# Orders from before this date (YYYY-MM-DD) never get an invoice. Empty = the first day the app was used.
INVOICE_START_DATE=

# ---------- Synology / Docker (only used by docker-compose.yml) ----------
# User and group id of the DSM user "factuurapp" (see docs/synology-nl.md, step 3)
PUID=1026
PGID=100
# Token of the Cloudflare Tunnel (Zero Trust → Networks → Tunnels). Keep it secret.
CLOUDFLARE_TUNNEL_TOKEN=

# ---------- E-mail with every invoice and credit note ----------
# true = every customer gets the PDF by e-mail. Keep false until the mailbox works (test with: npm run test-email -- you@example.com)
EMAIL_ENABLED=false
# Hostnet: smtp.hostnet.nl, port 587 (STARTTLS). Check this in the Hostnet control panel for the mailbox.
SMTP_HOST=smtp.hostnet.nl
SMTP_PORT=587
SMTP_USER=facturen@example.nl
# Password of the mailbox facturen@. Keep it secret.
SMTP_PASSWORD=
EMAIL_FROM="Your Shop <facturen@example.nl>"
# facturen@ is a no-reply address: a customer who presses Reply anyway ends up here. Empty = no Reply-To.
EMAIL_REPLY_TO=info@example.nl
# Optional: a copy of every e-mail, e.g. the invoice address of your bookkeeping software
EMAIL_BCC=
# en = English for everyone, auto = Dutch for NL/BE and English for the rest
EMAIL_LANGUAGE=en
